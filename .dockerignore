# Core ignores
.git
node_modules
.env
.DS_Store
*.log

# Ignore frontend files for the backend build, but ALLOW static assets
# This is required because backend/Dockerfile now copies frontend/static
# and the build context is set to the repository root.
frontend/cloudbuild.yaml
frontend/Dockerfile
frontend/go.mod
frontend/main.go
frontend.Dockerfile
cloudbuild-frontend.yaml

# Infrastructure and other service files
# We don't ignore backend/ files here because they are needed for the backend build
# when using the root context.
cloudbuild-backend.yaml
scripts/
e2e/
docs/
